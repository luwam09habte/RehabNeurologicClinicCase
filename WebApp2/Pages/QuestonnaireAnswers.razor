@page "/questonnaireanswers/{id:int}"
@using Core.Models
@layout MainLayout2
@inject HttpClient Http
@inject NavigationManager Nav

@if (questionnaire == null)
{
    <p>Indlæser...</p>
}
else
{
    <h3>@questionnaire.Title</h3>

    @foreach (var q in questionnaire.Questions)
    {
        <div>
            <p>@q.Text</p>

            @foreach (var option in q.Option)
            {
                <label>
                    <input type="radio" name="@q.QuestionId" value="@option" />
                    @option
                </label>
            }
        </div>
    }
}

@code {
    [Parameter] public int id { get; set; }

    private Questionnaire questionnaire;

    protected override async Task OnInitializedAsync()
    {
        questionnaire = await Http.GetFromJsonAsync<Questionnaire>($"http://localhost:5160/api/questionnaire/{id}");
    }
}