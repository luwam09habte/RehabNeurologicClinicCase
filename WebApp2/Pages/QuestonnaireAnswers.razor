@page "/questonnaireanswers/{id:int}"
@using Core.Models
@layout MainLayout2
@inject HttpClient Http
@inject NavigationManager Nav
@using Blazored.LocalStorage
@inject ILocalStorageService localStorage

@if (ShowPopup)
{
    <div class="popup-overlay">
        <div class="popup">
            <div class="content">
                <h3>Tak for dine svar!</h3>
                <p>Dit spørgeskema er besvaret og blevet sendt!</p>
                <button class="btn btn-primary" @onclick="ClosePopup">Luk</button>
            </div>
        </div>
    </div>
}
    
@if (questionnaire == null)
{
    <p>Indlæser...</p>
}
else
{
    <h3>@questionnaire.Title</h3>

    <div class="questionnaire">
        @foreach (var q in questionnaire.Questions)
        {
            <div class="question-row">
                <p class="question-text">@q.Text</p>

                <div class="options">
                    <div class="scale-labels">
                        <span>Aldrig</span>
                        <span>Altid</span>
                    </div>
                    <div class="radio-buttons">
                        @foreach (var option in q.Option)
                        {
                            <label class="option-label">
                                <input type="radio" name="@q.QuestionId" value="@option"
                                       @onchange="() => SaveAnswer(q.QuestionId, option)"/>
                                @option
                            </label>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
<button class="submitbtn" @onclick="OnClickSubmit">Send</button>

@code {
    [Parameter] public int id { get; set; }
    private Questionnaire questionnaire;
    private bool ShowPopup = false;
    private Dictionary<int, string> answers = new();
    private int patientId;

    protected override async Task OnInitializedAsync()
    {
        var patient = await localStorage.GetItemAsync<Patient>("Patient");
        patientId = patient.PatientId;
        
        questionnaire = await Http.GetFromJsonAsync<Questionnaire>(
            $"http://localhost:5160/api/questionnaire/{id}"
        );
    }

    private void SaveAnswer(int questionId, string option)
    {
        answers[questionId] = option;
    }
    
    private async Task OnClickSubmit()
    {
        try
        {
            var questionnaireAnswer = new QuestionnaireAnswer
            {
                QuestionnaireId = id,
                PatientId = patientId,
                SubmittedAt = DateTime.Now,
                Answers = answers.Select(a => new QuestionAnswer
                {
                    QuestionId = a.Key,
                    SelectedOption = a.Value
                }).ToList()
            };

            var response = await Http.PostAsJsonAsync("http://localhost:5160/api/questionnaireanswer/submit", questionnaireAnswer);
        
            Console.WriteLine($"PatientId: {patientId}");
            Console.WriteLine($"Status: {response.StatusCode}");
            Console.WriteLine($"Antal svar: {answers.Count}");

            ShowPopup = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Fejl: {ex.Message}");
            ShowPopup = true; // vis popup selv ved fejl så ClosePopup kan kaldes
        }
    }

    private void ClosePopup()
    {
        ShowPopup = false;
        Nav.NavigateTo("/questonnaireoverview", true);
    }
}
