@page "/questonnaireoverview"
@using Core.Models
@layout MainLayout2
@inject HttpClient Http
@inject NavigationManager Nav
@using Blazored.LocalStorage
@inject ILocalStorageService localStorage

<h5>Mine tilgængelige Spørgeskemaer</h5>

@if (questionnaires == null)
{
    <p>Indlæser...</p>
}
else if (questionnaires.Count == 0)
{
    <p>Du har ingen tilgængelige spørgeskemaer</p>
}
else
{
    @foreach (var q in questionnaires)
    {
        <div class="dashboard-card mb-2" style="cursor:pointer;" @onclick="() => GoTo(q.QuestionnaireId)">
            @q.Title
        </div>
    }
}

@code {
    private List<Questionnaire>? questionnaires;

    protected override async Task OnInitializedAsync()
    {
        var alleSpørgeskemaer = await Http.GetFromJsonAsync<List<Questionnaire>>(
            "http://localhost:5160/api/questionnaire");

        var answeredIds = await localStorage.GetItemAsync<List<int>>("answeredIds") ?? new List<int>();

        questionnaires = new List<Questionnaire>();

        foreach (var q in alleSpørgeskemaer)
        {
            if (!answeredIds.Contains(q.QuestionnaireId))
                questionnaires.Add(q);
        }
    }

    void GoTo(int id)
    {
        Nav.NavigateTo($"/questonnaireanswers/{id}");
    }
}