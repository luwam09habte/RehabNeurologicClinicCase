@page "/questonnaireoverview"
@using Core.Models
@layout MainLayout2
@inject HttpClient Http
@inject NavigationManager Nav
@using Blazored.LocalStorage
@inject ILocalStorageService localStorage

<h3 class="mb-4">
    Mine tilgængelige Spørgeskemaer
</h3>

@if (questionnaires == null)
{
    <p>Indlæser...</p>
}
else if (questionnaires.Count == 0)
{
    <p>Du har ingen tilgængelige spørgeskemaer</p>
}
else
{
    @foreach (var q in questionnaires)
    {
        <div class="card shadow-sm mb-3"
             style="cursor:pointer;"
             @onclick="() => GoTo(q.QuestionnaireId)">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h5 class="mb-2">
                            @q.Title
                        </h5>

                        <p class="mb-2 text-muted">
                            @q.Text
                        </p>
                        
                    </div>

                    <button class="btn btn-primary">
                        Start
                    </button>

                </div>

            </div>

        </div>
    }
}

@code {
    private List<Questionnaire>? questionnaires;

    protected override async Task OnInitializedAsync()
    {
        var patient = await localStorage.GetItemAsync<Patient>("Patient");

        if (patient == null)
        {
            questionnaires = new List<Questionnaire>();
            return;
        }
// Sender Get request til QuestionnaireAnswerController for at få alle tildelte spørgeskemaer til patienten
        var assigned =
            await Http.GetFromJsonAsync<List<QuestionnaireAnswerModel>>(
                $"api/questionnaireanswer/assigned/{patient.PatientId}"
            );

        var allQuestionnaires =
            await Http.GetFromJsonAsync<List<Questionnaire>>(
                "api/questionnaire"
            );

        var assignedIds = assigned?
                              .Select(x => x.QuestionnaireId)
                              .Distinct()
                              .ToList()
                          ?? new List<int>();

        questionnaires = allQuestionnaires?
                             .Where(q => assignedIds.Contains(q.QuestionnaireId))
                             .ToList()
                         ?? new List<Questionnaire>();
    }

    void GoTo(int id)
    {
        Nav.NavigateTo($"/questonnaireanswers/{id}");
    }
}
