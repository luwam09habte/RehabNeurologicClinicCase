@using Blazored.LocalStorage
@inherits LayoutComponentBase
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@using Core.Models

<div class="page">
    
    <!-- Alt der skal gå igen på alle sider som admin bortset fra login siden -->

    <!-- TOP BAR -->
    <div class="border-bottom p-3 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-0">RN Klinik Admin</h4>
            <small class="text-muted">Velkommen, @adminNavn</small>
        </div>
        <a href="#" class="text-decoration-none">Log ud</a>
    </div>

    <!-- NAV MENU -->
    <div class="p-3 border-bottom">
        <ul class="nav nav-pills gap-2">

            <li class="nav-item">
                <NavLink class="nav-link" href="/adminoverview" Match="NavLinkMatch.All">Oversigt</NavLink>
            </li>

            <li class="nav-item">
                <NavLink class="nav-link" href="/admin/patients">Patienter</NavLink>
            </li>

            <li class="nav-item">
                <NavLink class="nav-link" href="/admin/response">Spørgeskemaer</NavLink>
            </li>

            <li class="nav-item">
                <NavLink class="nav-link" href="/admin/answers">Svar</NavLink>
            </li>

            <li class="nav-item">
                <NavLink class="nav-link" href="/admin/assign">Tildel</NavLink>
            </li>

        </ul>

    </div>

    <!-- PAGE CONTENT -->
    <div class="p-4">
        @Body
    </div>

</div>

@code {
    private string adminNavn = "";

    protected override async Task OnInitializedAsync()
    {
        var admin = await sessionStorage.GetItemAsync<Admin>("Admin");
        if (admin != null)
            adminNavn = admin.Name;
    }
}