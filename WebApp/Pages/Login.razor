@page "/login"
@layout LoginLayout
@using Core.Models
@inject HttpClient Http
@inject NavigationManager Nav
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage


<div class="container mt-5" style="max-width:400px;">

    <h3 class="mb-3">Login</h3>

    <input class="form-control mb-2" placeholder="Email" @bind="email" />
    <input class="form-control mb-3" type="password" placeholder="Password" @bind="password" />

    @if (!string.IsNullOrEmpty(errorText))
    {
        <div class="alert alert-danger mb-2">@errorText</div>
    }

    <button class="btn btn-primary w-100" @onclick="OnClickLogin">Login</button>

</div>

@code {
    string email = "";
    string password = "";
    string errorText = "";

    public async Task OnClickLogin()
    {
        // Kalder på Validate endpoint med API
        var response = await Http.PostAsJsonAsync($"api/User/Validate?email={email}&password={password}", new {});

        if (response.IsSuccessStatusCode)
        {
            User? loggedIn = await response.Content.ReadFromJsonAsync<User>();

            if (loggedIn != null)
            {
                await sessionStorage.SetItemAsync("user", loggedIn);
                Nav.NavigateTo("/patient", true);
            }
            else
            {
                errorText = "Forkert email eller adgangskode - Prøv igen";
            }
        }
    }
}