@page "/admin/answers"
@using Core.Models
@inject HttpClient Http
@inject NavigationManager Nav

<h3 class="mb-4">Besvarelser</h3>

<!-- søg + filter -->
<div class="row mb-4 g-2">
    <a class="btn btn-secondary"
       href="@ExportUrl">
        Eksporter data
    </a>
    <div class="col-md-4">
        <input class="form-control"
               placeholder="Søg efter patient navn..."
               @bind="searchText"/>
    </div>

    <div class="col-md-4">
        <select class="form-select" @bind="selectedInjuryType">
            <option value="">Alle skadetyper</option>
            @foreach (var type in InjuryTypes)
            {
                <option value="@type">@type</option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <select class="form-select"
                @bind="selectedGender">

            <option value="">
                Alle køn
            </option>

            <option value="Mand">
                Mand
            </option>

            <option value="Kvinde">
                Kvinde
            </option>

            <option value="Andet">
                Andet
            </option>

        </select>
    </div>

    <div class="col-md-2">
        <input class="form-control"
               placeholder="Min alder"
               @bind="minAge"/>
    </div>

    <div class="col-md-2">
        <input class="form-control"
               placeholder="Max alder"
               @bind="maxAge"/>
    </div>
    
    <div class="col-md-4">

        <select class="form-select"
                @bind="selectedStatus">

            <option value="">
                Alle forløb
            </option>

            <option value="true">
                Afsluttede
            </option>

            <option value="false">
                Aktive
            </option>

        </select>

    </div>
    
    <div class="col-md-4">
        <select class="form-select"
                @bind="selectedFollowUpType">

            <option value="">
                Vælg opfølgning
            </option>

            @foreach (var type in Enum.GetValues<FollowUpType>())
            {
                <option value="@type.ToString()">
                    @type
                </option>
            }

        </select>
    </div>

    
</div>

@if (allAnswers == null || patients == null)
{
    <p>Indlæser...</p>
}
else if (!FilteredAnswers.Any())
{
    <p>Ingen besvarelser fundet.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Patient</th>
                <th>Skadetype</th>
                <th>Køn</th>
                <th>Alder</th>
                <th>Dato</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in FilteredAnswers)
            {
                var patient = GetPatient(a.PatientId);

                <tr>
                    <td>@patient?.Name</td>
                    <td>@patient?.InjuryType</td>
                    <td>@patient?.Gender</td>
                    <td>@patient?.Age</td>
                    <td>@a.SubmittedAt.ToShortDateString()</td>
                    <td>
                        <button class="btn btn-link p-0"
                                @onclick="@(() => Nav.NavigateTo($"/questionnaire/{a.Id}"))">
                            Se detaljer
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<QuestionnaireAnswerModel>? allAnswers;
    private List<Patient>? patients;
    private string searchText = "";
    private string selectedInjuryType = "";
    private string selectedGender = "";
    private string selectedStatus = "";
    private string minAge = "";
    private string maxAge = "";
    private string selectedFollowUpType = "";
    
    // Property med query parameter. Sender Get request til QuestionnaireAnswerController
    private string ExportUrl =>
        $"https://rnkliniksl.azurewebsites.net/api/questionnaireanswer/export" +
        $"?searchText={searchText}" +
        $"&injuryType={selectedInjuryType}" +
        $"&gender={selectedGender}" +
        $"&minAge={minAge}" +
        $"&maxAge={maxAge}" +
        $"&completed={selectedStatus}";

    // Henter alle svar og patienter og matcher derfefter på PatientId
    protected override async Task OnInitializedAsync()
    { patients = await Http.GetFromJsonAsync<List<Patient>>(
            "api/patient");

        allAnswers = await Http.GetFromJsonAsync<List<QuestionnaireAnswerModel>>(
            "api/questionnaireanswer");
    }

    private Patient? GetPatient(int patientId) =>
        patients?.FirstOrDefault(p => p.PatientId == patientId);

    private List<string> InjuryTypes = new()
    {
        "Covid-19",
        "Stress",
        "Hjerneskade/tbi",
        "Hjernerystelse",
        "Alzheimers",
        "TBI",
        "Slagtilfælde"
    };
    
    private IEnumerable<QuestionnaireAnswerModel> FilteredAnswers
    {
        get
        {
            var result = new List<QuestionnaireAnswerModel>();

            foreach (var a in allAnswers ?? new List<QuestionnaireAnswerModel>())
            {
                var p = GetPatient(a.PatientId);
                if (p == null) continue;

                if (!string.IsNullOrWhiteSpace(searchText))
                    if (!p.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                        continue;

                if (!string.IsNullOrWhiteSpace(selectedInjuryType))
                    if (p.InjuryType != selectedInjuryType)
                        continue;

                if (!string.IsNullOrWhiteSpace(selectedGender))
                    if (p.Gender != selectedGender)
                        continue;
                
                if (!string.IsNullOrWhiteSpace(selectedFollowUpType))
                {
                    if (!string.Equals(a.FollowUpType.ToString(), selectedFollowUpType, StringComparison.OrdinalIgnoreCase))
                        continue;
                }

                
                if (!string.IsNullOrWhiteSpace(selectedStatus))
                {
                    var samePatientAndQuestionnaire =
                        allAnswers
                            .Where(x =>
                                x.PatientId == a.PatientId &&
                                x.QuestionnaireId == a.QuestionnaireId)
                            .ToList();

                    // Et forløb er afsluttet, hvis ALLE opfølgninger findes
                    bool completed =
                        samePatientAndQuestionnaire.Any(x => x.FollowUpType == FollowUpType.FørBehandling) &&
                        samePatientAndQuestionnaire.Any(x => x.FollowUpType == FollowUpType.EfterBehandling) &&
                        samePatientAndQuestionnaire.Any(x => x.FollowUpType == FollowUpType.TreMånederEfter) &&
                        samePatientAndQuestionnaire.Any(x => x.FollowUpType == FollowUpType.SeksMånederEfter);

                    bool filterValue = bool.Parse(selectedStatus);

                    if (completed != filterValue)
                        continue;
                }


                if (!string.IsNullOrWhiteSpace(minAge))
                    if (p.Age < int.Parse(minAge))
                        continue;

                if (!string.IsNullOrWhiteSpace(maxAge))
                    if (p.Age > int.Parse(maxAge))
                        continue;

                result.Add(a);
            }

            return result;
        }
    }
}