@page "/admin/answers"
@using Core.Models
@inject HttpClient Http
@inject NavigationManager Nav

<h3>Besvarelser</h3>

@if (allAnswers == null)
{
    <p>Indlæser...</p>
}
else if (!allAnswers.Any())
{
    <p>Ingen besvarelser fundet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Patient ID</th>
            <th>Spørgeskema ID</th>
            <th>Dato</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var a in allAnswers)
        {
            <tr>
                <td>@a.PatientId</td>
                <td>@a.QuestionnaireId</td>
                <td>@a.SubmittedAt.ToShortDateString()</td>
                <td>
                    <button class="btn btn-link"
                            @onclick="@(() => Nav.NavigateTo($"admin/answers/{a.Id}"))">
                        Se detaljer
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<Core.Models.QuestionnaireAnswer>? allAnswers;

    protected override async Task OnInitializedAsync()
    {
        allAnswers = await Http.GetFromJsonAsync<List<Core.Models.QuestionnaireAnswer>>("http://localhost:5160/api/questionnaire");
    }
}