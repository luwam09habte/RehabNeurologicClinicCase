@page "/admin/response"
@using Core.Models
@using MongoDB.Bson.Serialization.Serializers
@layout MainLayout
@inject HttpClient Http

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Tilføj Spørgeskema Her:</h3>
    <button class="btn btn-primary" @onclick="OpenModal">+ Nyt Spørgeskema</button>
</div>

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Nyt Spørgeskema</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body">
                    <input class="form-control mb-3"
                           placeholder="Titel på spørgeskema"
                           @bind="questionnaire.Title"/>
                    <input class="form-control mb-3"
                            placeholder="Beskrivelse på spørgeskema"
                            @bind="questionnaire.Text"/>

                    <p>Vælg skadetyper:</p>
                    @foreach (var injury in availableInjuryTypes)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   id="@injury"
                                   checked="@questionnaire.InjuryTypes.Contains(injury)"
                                   @onchange="() => ToggleInjuryType(injury)"/>
                            <label class="form-check-label" for="@injury">@injury</label>
                        </div>
                    }

                    <button class="btn btn-primary mb-3 mt-3" @onclick="AddQuestion">Tilføj spørgsmål</button>

                    @foreach (var q in questionnaire.Questions)
                    {
                        <div class="dashboard-card mb-2">
                            <input class="form-control mb-3"
                                   placeholder="Skriv spørgsmål"
                                   @bind="q.Text"/>
                            <p>Svarmuligheder:</p>
                            @foreach (var option in q.Option)
                            {
                                <span class="me-2">@option</span>
                            }
                        </div>
                        <button class="btn btn-secondary" @onclick="() => DeleteQuestion(q)">Slet spørgsmål</button>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success mt-3">@successMessage</div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Annuller</button>
                    <button class="btn btn-success" @onclick="SaveQuestionnaire">Gem spørgeskema</button>
                </div>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

<h4 class="mt-4">Eksisterende spørgeskemaer</h4>

@if (questionnaires == null || questionnaires.Count == 0)
{
    <p>Ingen spørgeskemaer fundet</p>
}
else
{
    @foreach (var q in questionnaires)
    {
        <div class="dashboard-card mb-2">
            <h5>@q.Title</h5>
            <p>Antal spørgsmål: @q.Questions.Count</p>
            <p>Skadetyper: @string.Join(", ", q.InjuryTypes)</p>
            <button class="btn btn-secondary" type="button">
                Rediger
            </button>
        </div>
    }
}

@code {

    private Questionnaire questionnaire = new Questionnaire
    {
        Questions = new List<Question>()
    };

    private List<Questionnaire> questionnaires = new();
    private string successMessage = string.Empty;
    private bool showModal = false;

    // Liste af de skadetyper, der er tilgængelige som man kan vælge
    private List<string> availableInjuryTypes = new List<string>
    {
        "Covid-19",
        "Stress",
        "Hjerneskade/tbi",
        "Hjernerystelse",
        "Alzheimers"
    };

    private void OpenModal()
    {
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    protected override async Task OnInitializedAsync()
    {
        questionnaires = await Http.GetFromJsonAsync<List<Questionnaire>>(
            "http://localhost:5160/api/questionnaire");
    }

    // Tilføjer skadetype til spørgeskemaet
    void ToggleInjuryType(string injury)
    {
        if (questionnaire.InjuryTypes.Contains(injury))
            questionnaire.InjuryTypes.Remove(injury);
        else
            questionnaire.InjuryTypes.Add(injury);
    }
    
    // Tilføjer et spørgsmål til spørgeskema
    void AddQuestion()
    {
        questionnaire.Questions.Add(new Question
        {
            Option = new List<string> { "1", "2", "3", "4", "5" }
        });
    }
    
    // Fjerner spørgsmål hvis du har tilføjet et
    void DeleteQuestion(Question question)
    {
        questionnaire.Questions.Remove(question);
    }

    async Task SaveQuestionnaire()
    {
        questionnaire.AdminId = 1;
        var response = await Http.PostAsJsonAsync(
            "http://localhost:5160/api/questionnaire", questionnaire);

        if (response.IsSuccessStatusCode)
        {
            successMessage = "Spørgeskema gemt!";
            questionnaires.Add(questionnaire);
            questionnaire = new Questionnaire
            {
                Questions = new List<Question>()
            };
        }
        else
        {
            successMessage = "Fejl ved gemning af spørgeskema.";
        }
    }
}